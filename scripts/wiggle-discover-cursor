#!/usr/bin/env python3
"""
wiggle-discover-cursor — Theme-agnostic cursor capability discovery for Wiggle

Discovers:
  1. Active cursor theme name and source (env, gsettings, hyprland config)
  2. Active base cursor size and source (env, gsettings, hyprland config)
  3. Cursor backend and capability class:
       - xcursor_discrete: legacy XCursor theme with fixed bitmap assets
       - hyprcursor_discrete: Hyprcursor PNG theme with resize_algorithm=none
       - hyprcursor_scalable: Hyprcursor theme with SVG or bilinear/nearest resampling
       - unknown: uninspectable/unsupported theme (no unsafe native requests)
  4. Generates ENLARGEMENT_SIZES based on real theme capabilities and user's original size.

Output format on stdout:
  STATUS=OK
  THEME=<name>
  THEME_SRC=<source>
  SIZE=<pixels>
  SIZE_SRC=<source>
  BACKEND=<xcursor_discrete|hyprcursor_discrete|hyprcursor_scalable|unknown>
  CAPABILITY=<discrete|scalable|none>
  AVAILABLE_SIZES=<comma-separated sizes>
  ENLARGEMENT_SIZES=<comma-separated sizes>

MIT License
"""

import os
import sys
import struct
import re
import subprocess
import tempfile
import zlib
import binascii
import zipfile


SEARCH_PATHS = [
    os.path.expanduser("~/.local/share/icons"),
    os.path.expanduser("~/.icons"),
    "/usr/share/icons",
    "/usr/local/share/icons",
]

# Xcursor 1.0 file constants. The format's own dimension ceiling is 32767,
# which is far too large for a startup-time cursor preview. Real cursor themes
# normally provide assets up to 256px. These application limits still permit a
# 512x512 high-DPI image (or a narrow image up to 1024px on either axis) while
# bounding encoded pixels, decoded PNG memory, parsing work, and file reads.
XCURSOR_MAGIC = 0x72756358
XCURSOR_FILE_VERSION = 0x00010000
XCURSOR_IMAGE_TYPE = 0xfffd0002
XCURSOR_IMAGE_VERSION = 1
XCURSOR_FILE_HEADER_SIZE = 16
XCURSOR_TOC_ENTRY_SIZE = 12
XCURSOR_CHUNK_HEADER_SIZE = 16
XCURSOR_IMAGE_HEADER_SIZE = 36
MAX_XCURSOR_FILE_BYTES = 32 * 1024 * 1024
MAX_XCURSOR_TOC_ENTRIES = 4096
MAX_CURSOR_DIMENSION = 1024
MAX_CURSOR_PIXELS = 512 * 512


def _range_fits(total_size, offset, length):
    """Return whether [offset, offset + length) is inside a byte buffer."""
    return (offset >= 0 and length >= 0 and offset <= total_size and
            length <= total_size - offset)


def parse_xcursor(data):
    """Parse bounded Xcursor image metadata from arbitrary bytes.

    Invalid file-level structure rejects the file. Invalid image TOC entries
    are skipped so a later valid image in the same cursor can still be used.
    Returned pixel offsets always identify a complete, bounded payload.
    """
    if not isinstance(data, (bytes, bytearray, memoryview)):
        return []
    file_size = len(data)
    if file_size > MAX_XCURSOR_FILE_BYTES or file_size < XCURSOR_FILE_HEADER_SIZE:
        return []

    try:
        magic, header_size, version, ntoc = struct.unpack_from("<IIII", data, 0)
    except struct.error:
        return []
    if (magic != XCURSOR_MAGIC or version != XCURSOR_FILE_VERSION or
            header_size < XCURSOR_FILE_HEADER_SIZE or header_size > file_size or
            ntoc > MAX_XCURSOR_TOC_ENTRIES):
        return []

    # Division is intentionally performed before multiplication: this proves
    # both that the table-size multiplication is bounded and that the complete
    # TOC fits in the actual file.
    if ntoc > (file_size - header_size) // XCURSOR_TOC_ENTRY_SIZE:
        return []
    toc_size = ntoc * XCURSOR_TOC_ENTRY_SIZE
    toc_end = header_size + toc_size

    images = []
    for index in range(ntoc):
        toc_offset = header_size + index * XCURSOR_TOC_ENTRY_SIZE
        try:
            entry_type, nominal_size, chunk_offset = struct.unpack_from(
                "<III", data, toc_offset
            )
        except struct.error:
            return []  # Defensive; the complete TOC was already proven above.
        if entry_type != XCURSOR_IMAGE_TYPE:
            continue
        if not (1 <= nominal_size <= MAX_CURSOR_DIMENSION):
            continue
        if (chunk_offset < toc_end or
                not _range_fits(file_size, chunk_offset, XCURSOR_CHUNK_HEADER_SIZE)):
            continue

        try:
            chunk_header_size, chunk_type, chunk_subtype, chunk_version = \
                struct.unpack_from("<IIII", data, chunk_offset)
        except struct.error:
            continue
        if (chunk_type != XCURSOR_IMAGE_TYPE or chunk_type != entry_type or
                chunk_subtype != nominal_size or
                chunk_version != XCURSOR_IMAGE_VERSION or
                chunk_header_size < XCURSOR_IMAGE_HEADER_SIZE or
                not _range_fits(file_size, chunk_offset, chunk_header_size)):
            continue

        try:
            width, height, hot_x, hot_y, delay = struct.unpack_from(
                "<IIIII", data, chunk_offset + XCURSOR_CHUNK_HEADER_SIZE
            )
        except struct.error:
            continue
        if (width == 0 or height == 0 or
                width > MAX_CURSOR_DIMENSION or height > MAX_CURSOR_DIMENSION or
                width > MAX_CURSOR_PIXELS // height or
                hot_x >= width or hot_y >= height):
            continue

        pixel_count = width * height
        pixel_bytes = pixel_count * 4
        pixel_offset = chunk_offset + chunk_header_size
        if not _range_fits(file_size, pixel_offset, pixel_bytes):
            continue

        images.append({
            "nominal": nominal_size,
            "width": width,
            "height": height,
            "hot_x": hot_x,
            "hot_y": hot_y,
            "delay": delay,
            "pixel_offset": pixel_offset,
            "pixel_bytes": pixel_bytes,
        })
    return images


def _read_xcursor(path):
    """Read a regular cursor file without permitting an unbounded allocation."""
    try:
        with open(path, "rb") as cursor:
            data = cursor.read(MAX_XCURSOR_FILE_BYTES + 1)
        return data if len(data) <= MAX_XCURSOR_FILE_BYTES else None
    except OSError:
        return None


SHAPE_ROLE_MAP = {
    "default": ["default", "left_ptr", "arrow", "top_left_arrow", "left-arrow"],
    "pointer": ["link", "pointer", "hand2", "hand1", "pointing_hand"],
    "hand": ["link", "hand2", "hand1", "pointer", "pointing_hand"],
    "link": ["link", "hand2", "hand1", "pointer", "pointing_hand"],
    "text": ["text", "xterm", "ibeam"],
    "ibeam": ["text", "xterm", "ibeam"],
    "xterm": ["text", "xterm", "ibeam"],
    "resize": ["se-resize", "bottom_right_corner", "size_fdiag", "col-resize", "row-resize", "all-scroll", "move"],
    "col-resize": ["col-resize", "sb_h_double_arrow", "h_double_arrow", "ew-resize", "size-hor"],
    "row-resize": ["row-resize", "sb_v_double_arrow", "v_double_arrow", "ns-resize", "size-ver"],
    "all-scroll": ["all-scroll", "move", "grabbing", "closedhand", "size_all"],
    "move": ["move", "all-scroll", "grabbing", "closedhand", "size_all"],
    "grabbing": ["grabbing", "closedhand", "move", "all-scroll"],
    "grab": ["grab", "openhand", "hand1", "hand2"],
    "crosshair": ["crosshair", "cross", "tcross"],
    "wait": ["wait", "watch", "left_ptr_watch", "progress"],
    "progress": ["left_ptr_watch", "half-busy", "progress", "watch", "wait"],
    "not-allowed": ["not-allowed", "crossed_circle", "circle", "dnd_no_drop"],
    "help": ["help", "question_arrow", "whats_this"],
}


def iter_xcursor_files(theme_dir, shape_name="default"):
    """Yield distinct candidate cursor files in preferred/fallback order."""
    cursors_dir = os.path.join(theme_dir, "cursors")
    if not os.path.isdir(cursors_dir):
        return
    candidates = SHAPE_ROLE_MAP.get(shape_name, [shape_name])
    names = list(candidates)
    for def_name in SHAPE_ROLE_MAP["default"]:
        if def_name not in names:
            names.append(def_name)
    try:
        for f in sorted(os.listdir(cursors_dir)):
            if f not in names:
                names.append(f)
    except OSError:
        pass
    seen = set()
    for name in names:
        path = os.path.join(cursors_dir, name)
        try:
            real_path = os.path.realpath(path)
            if real_path not in seen and os.path.isfile(real_path):
                seen.add(real_path)
                yield real_path
        except OSError:
            continue

def find_theme_dir(theme_name):
    if not theme_name or "/" in theme_name or theme_name.startswith("."):
        return None
    for base in SEARCH_PATHS:
        cand = os.path.join(base, theme_name)
        if os.path.isdir(cand) and is_valid_cursor_theme_dir(cand):
            return cand
    for base in SEARCH_PATHS:
        cand = os.path.join(base, theme_name)
        if os.path.isdir(cand):
            return cand
    # Fallback to matched imported theme names (e.g. CursorSwitcher-Imported-<name>-*)
    for base in SEARCH_PATHS:
        if not os.path.isdir(base):
            continue
        try:
            for entry in sorted(os.listdir(base)):
                if theme_name.lower() in entry.lower():
                    cand = os.path.join(base, entry)
                    if os.path.isdir(cand) and is_valid_cursor_theme_dir(cand):
                        return cand
        except OSError:
            pass
    return None

def is_valid_cursor_theme_dir(theme_dir):
    if not theme_dir or not os.path.isdir(theme_dir):
        return False
    # Check Hyprcursor
    try:
        h_backend, _, _ = probe_hyprcursor(theme_dir)
        if h_backend:
            return True
    except Exception:
        pass
    # Check XCursor
    try:
        x_sizes = probe_xcursor(theme_dir)
        if x_sizes:
            return True
    except Exception:
        pass
    return False

def _get_systemd_user_env():
    env_map = {}
    try:
        res = subprocess.run(
            ["systemctl", "--user", "show-environment"],
            capture_output=True, text=True, timeout=1
        )
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    env_map[k.strip()] = v.strip().strip("'\"")
    except Exception:
        pass
    return env_map

def _get_uwsm_env():
    env_map = {}
    config_home = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
    for d in [os.path.join(config_home, "uwsm", "env-hyprland.d"), os.path.join(config_home, "uwsm", "env.d")]:
        if os.path.isdir(d):
            try:
                for fname in sorted(os.listdir(d)):
                    fpath = os.path.join(d, fname)
                    if os.path.isfile(fpath):
                        with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
                            for line in f:
                                line = line.strip()
                                if line.startswith("export "):
                                    line = line[7:].strip()
                                if "=" in line and not line.startswith("#"):
                                    k, v = line.split("=", 1)
                                    env_map[k.strip()] = v.strip().strip("'\"")
            except Exception:
                pass
    return env_map

def get_active_theme():
    systemd_env = _get_systemd_user_env()
    uwsm_env = _get_uwsm_env()

    candidates = []

    # 1. HYPRCURSOR_THEME from systemd / live user session (updated dynamically by Cursor Theme Manager)
    val = systemd_env.get("HYPRCURSOR_THEME", "").strip()
    if val:
        candidates.append((val, "systemd:HYPRCURSOR_THEME"))

    # 2. HYPRCURSOR_THEME from uwsm config
    val = uwsm_env.get("HYPRCURSOR_THEME", "").strip()
    if val:
        candidates.append((val, "uwsm:HYPRCURSOR_THEME"))

    # 3. HYPRCURSOR_THEME from process environment
    val = os.environ.get("HYPRCURSOR_THEME", "").strip()
    if val:
        candidates.append((val, "env:HYPRCURSOR_THEME"))

    # 4. XCURSOR_THEME from systemd / live user session
    val = systemd_env.get("XCURSOR_THEME", "").strip()
    if val:
        candidates.append((val, "systemd:XCURSOR_THEME"))

    # 5. XCURSOR_THEME from uwsm config
    val = uwsm_env.get("XCURSOR_THEME", "").strip()
    if val:
        candidates.append((val, "uwsm:XCURSOR_THEME"))

    # 6. XCURSOR_THEME from process environment
    val = os.environ.get("XCURSOR_THEME", "").strip()
    if val:
        candidates.append((val, "env:XCURSOR_THEME"))

    # 7. Hyprland getoption
    try:
        res = subprocess.run(
            ["hyprctl", "getoption", "cursor:theme", "-j"],
            capture_output=True, text=True, timeout=1
        )
        if res.returncode == 0:
            import json
            data = json.loads(res.stdout)
            val = data.get("str", "").strip()
            if val and val != "default":
                candidates.append((val, "hyprctl:cursor:theme"))
    except Exception:
        pass

    # 8. GSettings
    try:
        res = subprocess.run(
            ["gsettings", "get", "org.gnome.desktop.interface", "cursor-theme"],
            capture_output=True, text=True, timeout=1
        )
        if res.returncode == 0:
            val = res.stdout.strip().strip("'\"")
            if val and val != "default":
                candidates.append((val, "gsettings:cursor-theme"))
    except Exception:
        pass

    # 9. Check index.theme in standard icon directories
    for def_path in [
        os.path.expanduser("~/.icons/default/index.theme"),
        os.path.expanduser("~/.local/share/icons/default/index.theme"),
        "/usr/share/icons/default/index.theme"
    ]:
        if os.path.isfile(def_path):
            try:
                with open(def_path, "r", encoding="utf-8", errors="ignore") as f:
                    for line in f:
                        if line.strip().startswith("Inherits="):
                            val = line.strip().split("=", 1)[1].strip()
                            if val:
                                candidates.append((val, f"index.theme:{def_path}"))
            except Exception:
                pass

    # Validate candidates in order
    for name, src in candidates:
        tdir = find_theme_dir(name)
        if tdir and is_valid_cursor_theme_dir(tdir):
            return name, src

    # 10. Fallback: search standard theme directories for any installed working theme
    for fallback_name in ["Adwaita", "AdwaitaLegacy", "breeze", "breeze-dark", "Yaru", "default"]:
        tdir = find_theme_dir(fallback_name)
        if tdir and is_valid_cursor_theme_dir(tdir):
            return fallback_name, f"fallback:{fallback_name}"

    for base in SEARCH_PATHS:
        if os.path.isdir(base):
            try:
                for entry in sorted(os.listdir(base)):
                    cand_path = os.path.join(base, entry)
                    if os.path.isdir(cand_path) and is_valid_cursor_theme_dir(cand_path):
                        return entry, f"discovered:{cand_path}"
            except OSError:
                pass

    return "default", "fallback:default"

def get_active_size():
    systemd_env = _get_systemd_user_env()
    uwsm_env = _get_uwsm_env()

    # 1. Check HYPRCURSOR_SIZE from systemd (updated dynamically by Cursor Theme Manager)
    val = systemd_env.get("HYPRCURSOR_SIZE", "").strip()
    if val and val.isdigit() and int(val) > 0:
        return int(val), "systemd:HYPRCURSOR_SIZE"

    # 2. Check HYPRCURSOR_SIZE from uwsm
    val = uwsm_env.get("HYPRCURSOR_SIZE", "").strip()
    if val and val.isdigit() and int(val) > 0:
        return int(val), "uwsm:HYPRCURSOR_SIZE"

    # 3. Check HYPRCURSOR_SIZE from env
    val = os.environ.get("HYPRCURSOR_SIZE", "").strip()
    if val and val.isdigit() and int(val) > 0:
        return int(val), "env:HYPRCURSOR_SIZE"

    # 4. Check XCURSOR_SIZE from systemd
    val = systemd_env.get("XCURSOR_SIZE", "").strip()
    if val and val.isdigit() and int(val) > 0:
        return int(val), "systemd:XCURSOR_SIZE"

    # 5. Check XCURSOR_SIZE from uwsm
    val = uwsm_env.get("XCURSOR_SIZE", "").strip()
    if val and val.isdigit() and int(val) > 0:
        return int(val), "uwsm:XCURSOR_SIZE"

    # 6. Check XCURSOR_SIZE from env
    val = os.environ.get("XCURSOR_SIZE", "").strip()
    if val and val.isdigit() and int(val) > 0:
        return int(val), "env:XCURSOR_SIZE"

    # 7. Check GSettings
    try:
        res = subprocess.run(
            ["gsettings", "get", "org.gnome.desktop.interface", "cursor-size"],
            capture_output=True, text=True, timeout=1
        )
        if res.returncode == 0:
            val = res.stdout.strip()
            if val.isdigit() and int(val) > 0:
                return int(val), "gsettings:cursor-size"
    except Exception:
        pass

    # 8. Check Hyprland getoption
    try:
        res = subprocess.run(
            ["hyprctl", "getoption", "cursor:size", "-j"],
            capture_output=True, text=True, timeout=1
        )
        if res.returncode == 0:
            import json
            data = json.loads(res.stdout)
            val = data.get("int", 0)
            if val > 0:
                return val, "hyprctl:cursor:size"
    except Exception:
        pass

    return 24, "fallback:default"

def probe_xcursor(theme_dir):
    for cursor_file in iter_xcursor_files(theme_dir):
        data = _read_xcursor(cursor_file)
        if data is None:
            continue
        images = parse_xcursor(data)
        if images:
            return sorted({image["nominal"] for image in images})
    return []

def find_xcursor_file(theme_dir):
    return next(iter_xcursor_files(theme_dir), None)

def png_chunk(kind, payload):
    return (struct.pack(">I", len(payload)) + kind + payload +
            struct.pack(">I", binascii.crc32(kind + payload) & 0xffffffff))

def export_xcursor_image(theme_dir, wanted_size=24, shape_name="default"):
    """Export the nearest cursor frame for shape_name as straight-alpha RGBA PNG."""
    for cursor_file in iter_xcursor_files(theme_dir, shape_name):
        data = _read_xcursor(cursor_file)
        if data is None:
            continue
        images = parse_xcursor(data)
        if not images:
            continue
        image = min(images, key=lambda item: abs(item["nominal"] - wanted_size))
        width = image["width"]
        height = image["height"]
        hot_x = image["hot_x"]
        hot_y = image["hot_y"]
        pixel_offset = image["pixel_offset"]

        # Allocation is bounded by MAX_CURSOR_PIXELS above. Decode one pixel at
        # a time so attacker-controlled dimensions cannot create a giant tuple.
        stride = 1 + width * 4
        raw = bytearray(stride * height)
        for y in range(height):
            row_offset = y * stride
            raw[row_offset] = 0  # PNG filter type: None
            for x in range(width):
                source_offset = pixel_offset + (y * width + x) * 4
                pixel = struct.unpack_from("<I", data, source_offset)[0]
                a = (pixel >> 24) & 255
                r = (pixel >> 16) & 255
                g = (pixel >> 8) & 255
                b = pixel & 255
                if 0 < a < 255:
                    r = min(255, (r * 255 + a // 2) // a)
                    g = min(255, (g * 255 + a // 2) // a)
                    b = min(255, (b * 255 + a // 2) // a)
                dest = row_offset + 1 + x * 4
                raw[dest:dest + 4] = bytes((r, g, b, a))

        runtime = os.environ.get("XDG_RUNTIME_DIR")
        if not runtime or not os.path.isdir(runtime):
            return "", 0, 0, 0, 0

        wiggle_dir = os.path.join(runtime, "wiggle")
        os.makedirs(wiggle_dir, mode=0o700, exist_ok=True)
        try:
            os.chmod(wiggle_dir, 0o700)
        except OSError:
            pass

        output = os.path.join(wiggle_dir, "wiggle-cursor.png")
        png = b"\x89PNG\r\n\x1a\n"
        png += png_chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0))
        png += png_chunk(b"IDAT", zlib.compress(bytes(raw), 1))
        png += png_chunk(b"IEND", b"")

        # Atomic secure creation with 0600 mode
        tmp_fd, tmp_path = tempfile.mkstemp(prefix="cur_", suffix=".tmp", dir=wiggle_dir)
        try:
            os.write(tmp_fd, png)
            os.close(tmp_fd)
            os.chmod(tmp_path, 0o600)
            os.replace(tmp_path, output)
        except Exception:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
            return "", 0, 0, 0, 0

        return output, hot_x, hot_y, width, height
    return "", 0, 0, 0, 0

def _write_extracted_asset(data_bytes, suffix):
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime or not os.path.isdir(runtime):
        return ""
    wiggle_dir = os.path.join(runtime, "wiggle")
    os.makedirs(wiggle_dir, mode=0o700, exist_ok=True)
    try:
        os.chmod(wiggle_dir, 0o700)
    except OSError:
        pass
    output = os.path.join(wiggle_dir, f"wiggle-cursor{suffix}")
    tmp_fd, tmp_path = tempfile.mkstemp(prefix="cur_", suffix=".tmp", dir=wiggle_dir)
    try:
        os.write(tmp_fd, data_bytes)
        os.close(tmp_fd)
        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, output)
        return output
    except Exception:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
        return ""

def find_hyprcursor_shape(theme_dir, shape_name="default"):
    manifest_candidates = [
        os.path.join(theme_dir, "manifest.hl"),
        os.path.join(theme_dir, "manifest.toml")
    ]
    manifest_path = next((m for m in manifest_candidates if os.path.exists(m)), None)
    if not manifest_path:
        return None, None

    cursors_dir_name = "hyprcursors"
    try:
        with open(manifest_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if "cursors_directory" in line and "=" in line:
                    parts = line.split("=", 1)
                    val = parts[1].strip().strip("'\"")
                    if val:
                        cursors_dir_name = val
    except Exception:
        pass

    shapes_dir = os.path.join(theme_dir, cursors_dir_name)
    if not os.path.isdir(shapes_dir):
        return None, None

    candidates = SHAPE_ROLE_MAP.get(shape_name, [shape_name])
    names = list(candidates)
    for def_name in SHAPE_ROLE_MAP["default"]:
        if def_name not in names:
            names.append(def_name)

    shape_file = None
    for cand_name in names:
        for ext in [".hlc", ".hl", ".meta", ""]:
            p = os.path.join(shapes_dir, cand_name + ext)
            if os.path.isfile(p):
                shape_file = p
                break
        if shape_file:
            break

    if not shape_file:
        files = [f for f in os.listdir(shapes_dir) if f.endswith(".hlc") or f.endswith(".hl") or f.endswith(".meta")]
        if files:
            shape_file = os.path.join(shapes_dir, sorted(files)[0])

    return shapes_dir, shape_file

def _parse_hyprcursor_lines(lines, shapes_dir, shape_file, wanted_size=24):
    resize_algo = "none"
    has_svg = False
    discrete_sizes = set()
    best_diff = float("inf")
    best_size = 0
    best_target = None
    best_hx = 0.0
    best_hy = 0.0
    global_hx = None
    global_hy = None

    for line in lines:
        line = line.strip()
        if line.startswith("#") or not line:
            continue
        if "resize_algorithm" in line and "=" in line:
            parts = line.split("=", 1)
            resize_algo = parts[1].strip().lower()
        elif "hotspot_x" in line and "=" in line:
            parts = line.split("=", 1)
            val = parts[1].strip()
            if val.replace(".", "", 1).replace("-", "", 1).isdigit():
                global_hx = float(val)
        elif "hotspot_y" in line and "=" in line:
            parts = line.split("=", 1)
            val = parts[1].strip()
            if val.replace(".", "", 1).replace("-", "", 1).isdigit():
                global_hy = float(val)
        elif "define_size" in line and "=" in line:
            parts = line.split("=", 1)
            args = [a.strip() for a in parts[1].split(",")]
            if len(args) >= 2:
                sz = int(args[0]) if args[0].isdigit() else 0
                target = args[1]
                # Per Hyprcursor spec, 3rd arg is delay (or in some legacy formats hx, hy)
                hx = float(args[2]) if len(args) >= 4 and args[2].replace(".", "", 1).isdigit() else 0.0
                hy = float(args[3]) if len(args) >= 4 and args[3].replace(".", "", 1).isdigit() else 0.0

                if target.lower().endswith(".svg") or sz == 0:
                    has_svg = True
                    if not best_target or best_target.lower().endswith(".svg"):
                        best_size = sz if sz > 0 else (wanted_size or 256)
                        best_target = target
                        best_hx = hx
                        best_hy = hy
                elif sz > 0:
                    discrete_sizes.add(sz)
                    diff = abs(sz - wanted_size)
                    if diff < best_diff:
                        best_diff = diff
                        best_size = sz
                        best_target = target
                        best_hx = hx
                        best_hy = hy

    if best_target and (global_hx is not None or global_hy is not None):
        best_hx = (global_hx or 0.0) * (best_size or wanted_size or 24)
        best_hy = (global_hy or 0.0) * (best_size or wanted_size or 24)

    return resize_algo, has_svg, discrete_sizes, best_size, best_target, best_hx, best_hy

def export_hyprcursor_image(theme_dir, wanted_size=24, shape_name="default"):
    shapes_dir, shape_file = find_hyprcursor_shape(theme_dir, shape_name)
    if not shape_file:
        return "", 0, 0, 0, 0

    lines = []
    is_hlc = shape_file.endswith(".hlc") or zipfile.is_zipfile(shape_file)

    if is_hlc:
        try:
            with zipfile.ZipFile(shape_file, "r") as zf:
                if "meta.hl" in zf.namelist():
                    lines = zf.read("meta.hl").decode("utf-8", "ignore").splitlines()
        except Exception:
            return "", 0, 0, 0, 0
    else:
        try:
            with open(shape_file, "r", encoding="utf-8", errors="ignore") as f:
                lines = f.readlines()
        except Exception:
            return "", 0, 0, 0, 0

    algo, has_svg, disc, best_size, best_target, best_hx, best_hy = _parse_hyprcursor_lines(
        lines, shapes_dir, shape_file, wanted_size
    )

    if not best_target:
        return "", 0, 0, 0, 0

    if is_hlc:
        try:
            with zipfile.ZipFile(shape_file, "r") as zf:
                if best_target in zf.namelist():
                    data = zf.read(best_target)
                    ext = os.path.splitext(best_target)[1]
                    out_path = _write_extracted_asset(data, ext)
                    if out_path:
                        img_size = best_size if best_size > 0 else (wanted_size or 256)
                        return out_path, int(round(best_hx)), int(round(best_hy)), img_size, img_size
        except Exception:
            pass
        return "", 0, 0, 0, 0
    else:
        file_path = os.path.join(shapes_dir, best_target)
        if os.path.isfile(file_path):
            img_size = best_size if best_size > 0 else (wanted_size or 256)
            return file_path, int(round(best_hx)), int(round(best_hy)), img_size, img_size

    return "", 0, 0, 0, 0

def probe_hyprcursor(theme_dir, shape_name="default"):
    shapes_dir, shape_file = find_hyprcursor_shape(theme_dir, shape_name)
    if not shape_file:
        return None, "none", []

    lines = []
    is_hlc = shape_file.endswith(".hlc") or zipfile.is_zipfile(shape_file)

    if is_hlc:
        try:
            with zipfile.ZipFile(shape_file, "r") as zf:
                if "meta.hl" in zf.namelist():
                    lines = zf.read("meta.hl").decode("utf-8", "ignore").splitlines()
        except Exception:
            return "hyprcursor_unknown", "none", []
    else:
        try:
            with open(shape_file, "r", encoding="utf-8", errors="ignore") as f:
                lines = f.readlines()
        except Exception:
            return "hyprcursor_unknown", "none", []

    resize_algo, has_svg, discrete_sizes, _, _, _, _ = _parse_hyprcursor_lines(
        lines, shapes_dir, shape_file
    )

    if has_svg or resize_algo in ("bilinear", "nearest"):
        return "hyprcursor_scalable", "scalable", sorted(list(discrete_sizes))
    elif discrete_sizes:
        return "hyprcursor_discrete", "discrete", sorted(list(discrete_sizes))
    else:
        return "hyprcursor_unknown", "none", []


def main():
    import argparse
    parser = argparse.ArgumentParser(description="Wiggle Cursor Discovery")
    parser.add_argument("--theme", default=None, help="Explicit theme name")
    parser.add_argument("--size", type=int, default=None, help="Explicit base cursor size")
    parser.add_argument("--shape", default="default", help="Semantic shape name / role")
    args = parser.parse_args()

    theme_name, theme_src = (args.theme, "cli:--theme") if args.theme else get_active_theme()
    base_size, size_src = (args.size, "cli:--size") if args.size else get_active_size()
    shape_name = args.shape

    theme_dir = find_theme_dir(theme_name)
    backend = "unknown"
    capability = "none"
    available_sizes = []

    if theme_dir:
        # Check Hyprcursor first
        h_backend, h_cap, h_sizes = probe_hyprcursor(theme_dir, shape_name)
        if h_backend:
            backend = h_backend
            capability = h_cap
            available_sizes = h_sizes
        else:
            # Check XCursor
            x_sizes = probe_xcursor(theme_dir)
            if x_sizes:
                backend = "xcursor_discrete"
                capability = "discrete"
                available_sizes = x_sizes

    image_path = ""
    hot_x = hot_y = image_width = image_height = 0
    hi_res_target = max(available_sizes) if available_sizes else (base_size * 4)

    if theme_dir:
        if backend.startswith("hyprcursor"):
            image_path, hot_x, hot_y, image_width, image_height = export_hyprcursor_image(
                theme_dir, hi_res_target, shape_name
            )
        if not image_path and (backend == "xcursor_discrete" or probe_xcursor(theme_dir)):
            image_path, hot_x, hot_y, image_width, image_height = export_xcursor_image(
                theme_dir, hi_res_target, shape_name
            )

    avail_str = ",".join(str(s) for s in available_sizes)

    print("STATUS=OK")
    print(f"THEME={theme_name}")
    print(f"THEME_SRC={theme_src}")
    print(f"SIZE={base_size}")
    print(f"SIZE_SRC={size_src}")
    print(f"BACKEND={backend}")
    print(f"CAPABILITY={capability}")
    print(f"AVAILABLE_SIZES={avail_str}")
    print(f"CURSOR_IMAGE={image_path}")
    print(f"CURSOR_HOTSPOT={hot_x},{hot_y}")
    print(f"CURSOR_IMAGE_SIZE={image_width},{image_height}")

if __name__ == "__main__":
    main()
