{
    "schemaVersion": 1,
    "id": "io.github.sanjyay.wiggle",
    "name": "Wiggle",
    "version": "2.0.0-experimental",
    "author": "sanjyay",
    "license": "MIT",
    "description": "Shake your mouse to find your cursor.",
    "kinds": ["service"],
    "entryPoints": {
        "service": "Plugin.qml"
    },
    "keepLoaded": true,
    "wiggle": {
        "backend": "native",
        "native": {
            "enabled": true,
            "sensitivity": 4.0,
            "maxScale": 4.0
        }
    }
}
